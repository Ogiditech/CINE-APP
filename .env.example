# CineBook Environment Configuration

# Database (Neon Serverless PostgreSQL)
# Pooled connection string for regular app queries
DATABASE_URL="postgres://neondb_owner:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Unpooled connection string for migrations (optional)
DATABASE_URL_UNPOOLED="postgres://neondb_owner:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Authentication
JWT_SECRET="cinebook_production_super_secure_jwt_secret_key_32_bytes_min"

# Vercel Cron Authentication Secret
CRON_SECRET="cinebook_cron_secret_auth_token_9921"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Payments (Test Mode)
# Leave as test-mode or replace with your Stripe test keys
STRIPE_SECRET_KEY="sk_test_cinebook_demo_mode_key"
STRIPE_WEBHOOK_SECRET="whsec_cinebook_demo_webhook_secret"

# Vercel Blob Storage (Optional, for movie banner uploads)
BLOB_READ_WRITE_TOKEN=""
